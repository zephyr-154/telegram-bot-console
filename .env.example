BOT_TOKEN=123456789:replace_me
# 多個群組／頻道 ID 以逗號分隔，例如 -1001234567890,-1009876543210。
CHANNEL_ID=-1001234567890
# 多位管理員以逗號分隔，例如 123456789,987654321；每位先私訊 Bot 按 /start。
ADMIN_USER_ID=123456789
DATABASE_PATH=./data/bot.sqlite3
TEMP_DIR=./data/tmp
FONT_REGULAR_PATH=./assets/fonts/NotoSansTC-Regular.otf
FONT_BOLD_PATH=./assets/fonts/NotoSansTC-Bold.otf
# 留空時使用程式內建的開發用藍色圓形紙飛機 fallback。
TELEGRAM_LOGO_PATH=
CONTENT_HASH_SECRET=replace_with_a_long_random_secret_at_least_32_chars
TIMEZONE=Asia/Taipei
