# 請在 VPS 上把下列三個欄位改成真實值，再啟動服務。
# 不要把 Bot Token 貼到聊天視窗或提交到 Git。
BOT_TOKEN=123456789:請填入你的BotFatherToken
CHANNEL_ID=-1001234567890
ADMIN_USER_ID=123456789

DATABASE_PATH=/opt/telegram-anonymous-board/data/bot.sqlite3
TEMP_DIR=/opt/telegram-anonymous-board/data/tmp
FONT_REGULAR_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
FONT_BOLD_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Bold.ttc
TELEGRAM_LOGO_PATH=
CONTENT_HASH_SECRET=請改成至少32字元的隨機秘密
TIMEZONE=Asia/Taipei
