include .env.example requirements.txt tgbot.cmd LICENSE
recursive-include deploy *.sh *.service *.timer .env.vps.example
recursive-include assets .gitkeep
recursive-include docs *.md
recursive-include docs/assets *.svg
recursive-include tests *.py
prune data
prune .venv
prune dist
global-exclude *.py[cod]
exclude .env .env.bak
